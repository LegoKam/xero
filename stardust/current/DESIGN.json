      "sizes": { "xxl": "51.6px", "xl": "42px", "l": "21.96px", "m": "18px", "s": "16px", "xs": "14px" },
      "note": "Source face National2 (licensed); Inter substituted."
    },
    "body": {
      "family": "Inter, 'Helvetica Neue', Helvetica, Arial, sans-serif",
