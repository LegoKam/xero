    "xero-blue": "#1f65d6",
    "xero-blue-dark": "#184390",
    "mint-green": "#50dcaa",
    "mint-green-dark": "#4ac49d",
    "cyan": "#13b5ea",
    "grey-blue": "#ecf2f6",
    "mist": "#f5f9fa",
    "sand": "#f2f1ee",
    "white": "#ffffff"
  },
  "typography": {
    "heading": {
      "family": "Inter, 'Helvetica Neue', Helvetica, Arial, sans-serif",
      "weight": "700",
      "style": "normal",
